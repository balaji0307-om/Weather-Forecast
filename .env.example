# Optional token for protecting your own FastAPI endpoints.
# Leave empty for local beginner/demo use.
WEATHER_API_TOKEN=

# Comma-separated frontend origins for production, for example:
# ALLOWED_ORIGINS=https://your-weather-app.vercel.app,http://127.0.0.1:5173
ALLOWED_ORIGINS=*

# Backend protections and performance settings.
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
CACHE_TTL_SECONDS=300

# SQLite file used for recent searches.
DATABASE_PATH=backend/weather.db

# Frontend can send this only for local/private deployments.
VITE_API_BASE=http://127.0.0.1:8000
VITE_API_TOKEN=
